GestureInterface, #view {
    background-color: transparent;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

#gestureStatusLabel[active="true"] {
    color: #4dcb66;
}

#gestureStatusLabel[active="false"] {
    color: #8a8a8a;
}

#gestureResultLabel {
    color: #4da3ff;
    font-size: 16px;
}

#gestureDiagnosticLabel {
    color: #a8a8a8;
}
