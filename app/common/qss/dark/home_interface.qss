HomeInterface, #view {
    background-color: transparent;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

#titleLabel {
    color: white;
    font-size: 30px;
    font-weight: bold;
}

#subtitleLabel {
    color: rgba(255, 255, 255, 150);
    font-size: 14px;
}

#modeCard {
    background-color: rgba(255, 255, 255, 12);
    border: 1px solid rgba(255, 255, 255, 16);
    border-radius: 8px;
}
