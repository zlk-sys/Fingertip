CollabInterface, #view {
    background-color: transparent;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

#collabStatusLabel[active="true"] {
    color: #00b42a;
}

#collabStatusLabel[active="false"] {
    color: #9c9c9c;
}

#chatBubble {
    background-color: #f0f0f0;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 8px;
}

#chatBubbleUser {
    background-color: #e8f5e9;
    border: 1px solid #c8e6c9;
    border-radius: 8px;
    padding: 8px;
}

#chatBubbleAssistant {
    background-color: #f5f5f5;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 8px;
}
